package br.ifma.clinica.app;

import br.ifma.clinica.excecao.AnimalNaoEncontradoException;
import br.ifma.clinica.modelo.Cao;
import br.ifma.clinica.modelo.Gato;
import br.ifma.clinica.servico.Clinica;


public class Main {

    /**
     * Ponto de entrada do programa.
     *
     * @param args argumentos da linha de comando (não utilizados)
     */
    public static void main(String[] args) {
        Clinica clinica = new Clinica();
        clinica.cadastrar(new Cao("Rex", 30));
        clinica.cadastrar(new Gato("Mimi", 4));

        try {
            clinica.atender("Rex");
            clinica.atender("Mimi");
            clinica.atender("Bidu");
        } catch (AnimalNaoEncontradoException e) {
            System.out.println("Erro: " + e.getMessage());
        }

        System.out.println("Histórico de atendimentos:");
        for (String registro : clinica.listarHistorico()) {
            System.out.println(registro);
        }
    }
}
